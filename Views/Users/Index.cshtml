@model List<CentalMvc.Models.ViewModels.UserRowViewModel>
@{
    ViewData["Title"] = "Users";
    ViewData["Active"] = "users";
    Layout = "_AdminLayout";
}

<div class="panel">
    <div class="panel-head">
        <h5><i class="fas fa-users me-2"></i>Registered Users (@Model.Count)</h5>
    </div>

    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No users yet.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Joined</th><th style="text-align:right;">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="car-name">@u.FullName</td>
                        <td>@u.Email</td>
                        <td>@(string.IsNullOrEmpty(u.Phone) ? "-" : u.Phone)</td>
                        <td>
                            @if (u.Role == "Admin")
                            {
                                <span class="badge-pill badge-confirmed">Admin</span>
                            }
                            else
                            {
                                <span class="badge-pill badge-yes">Customer</span>
                            }
                        </td>
                        <td>@u.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td style="text-align:right;white-space:nowrap;">
                            @if (u.Role != "Admin")
                            {
                                <form asp-controller="Users" asp-action="Delete" method="post" style="display:inline;"
                                      onsubmit="return confirm('Delete this user?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                                </form>
                            }
                            else
                            {
                                <span style="color:#6b7688;font-size:13px;">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
