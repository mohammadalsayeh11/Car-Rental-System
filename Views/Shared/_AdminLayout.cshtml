@{
    var user = User.Identity?.Name;
    var active = ViewData["Active"] as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Cental Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Lato:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" />
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            <div class="admin-brand">
                <i class="fas fa-car-alt"></i>
                <span>Cental<small>Admin</small></span>
            </div>
            <nav class="admin-nav">
                <a asp-controller="Admin" asp-action="Index" class="@(active=="dashboard"?"active":"")"><i class="fas fa-gauge-high"></i> Dashboard</a>
                <a asp-controller="Cars" asp-action="Index" class="@(active=="cars"?"active":"")"><i class="fas fa-car"></i> Cars</a>
                <a asp-controller="Bookings" asp-action="Index" class="@(active=="bookings"?"active":"")"><i class="fas fa-calendar-check"></i> Bookings</a>
                <a asp-controller="Users" asp-action="Index" class="@(active=="users"?"active":"")"><i class="fas fa-users"></i> Users</a>
                <a asp-controller="Messages" asp-action="Index" class="@(active=="messages"?"active":"")"><i class="fas fa-envelope"></i> Messages</a>
                <a asp-controller="Home" asp-action="Index" target="_blank"><i class="fas fa-globe"></i> View Site</a>
            </nav>
            <form asp-controller="Auth" asp-action="Logout" method="post" style="margin-top:10px;">
                @Html.AntiForgeryToken()
                <button type="submit" class="admin-logout" style="width:100%;border:none;background:none;text-align:left;cursor:pointer;"><i class="fas fa-right-from-bracket"></i> Logout</button>
            </form>
        </aside>

        <main class="admin-main">
            <header class="admin-topbar">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <div class="admin-user"><i class="fas fa-user-shield"></i> @user</div>
            </header>
            <div class="admin-content">
                @if (TempData["Msg"] != null)
                {
                    <div class="admin-alert"><i class="fas fa-circle-check me-2"></i>@TempData["Msg"]</div>
                }
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
