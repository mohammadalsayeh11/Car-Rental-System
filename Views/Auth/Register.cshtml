@model CentalMvc.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Register - Cental</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Lato:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" />
</head>
<body class="admin-body">
    <div class="login-page">
        <div class="login-card" style="max-width:460px;">
            <div class="login-logo"><i class="fas fa-car-alt"></i> Cental</div>
            <div class="login-sub">Create a new account</div>

            <div asp-validation-summary="ModelOnly" class="login-error" style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none;")"></div>

            <form asp-controller="Auth" asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group" style="margin-bottom:14px;">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" class="form-control" placeholder="John Doe" autofocus />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="form-group" style="margin-bottom:14px;">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" placeholder="you@email.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group" style="margin-bottom:14px;">
                    <label asp-for="Phone"></label>
                    <input asp-for="Phone" class="form-control" placeholder="+962 7..." />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="form-group" style="margin-bottom:14px;">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-neon"><i class="fas fa-user-plus"></i> Create Account</button>
            </form>

            <div class="login-hint">
                Already have an account?
                <a asp-controller="Auth" asp-action="Login" style="color:var(--neon-cyan);">Sign In</a>
            </div>
        </div>
    </div>
</body>
</html>
