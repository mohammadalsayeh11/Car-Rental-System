@model CentalMvc.Models.Car
@{
    ViewData["Title"] = "Add New Car";
    ViewData["Active"] = "cars";
    Layout = "_AdminLayout";
}

<div class="panel" style="max-width:900px;">
    <div class="panel-head">
        <h5><i class="fas fa-car me-2"></i>Add New Car</h5>
        <a asp-controller="Cars" asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
    </div>

    <form asp-controller="Cars" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        @if (Model.Id != 0)
        {
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
        }
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Name">Car Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. BMW 320" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Brand">Brand</label>
                <input asp-for="Brand" class="form-control" placeholder="e.g. BMW" />
                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CarType">Type</label>
                <input asp-for="CarType" class="form-control" placeholder="SUV / Sedan / Sports" />
                <span asp-validation-for="CarType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ModelYear">Model Year</label>
                <input asp-for="ModelYear" type="number" class="form-control" placeholder="2024" />
                <span asp-validation-for="ModelYear" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PricePerDay">Price / Day ($)</label>
                <input asp-for="PricePerDay" type="number" step="0.01" class="form-control" placeholder="60" />
                <span asp-validation-for="PricePerDay" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Seats">Seats</label>
                <input asp-for="Seats" type="number" class="form-control" placeholder="5" />
            </div>
            <div class="form-group">
                <label asp-for="Transmission">Transmission</label>
                <select asp-for="Transmission" class="form-select">
                    <option>Automatic</option>
                    <option>Manual</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="FuelType">Fuel Type</label>
                <select asp-for="FuelType" class="form-select">
                    <option>Petrol</option>
                    <option>Diesel</option>
                    <option>Hybrid</option>
                    <option>Electric</option>
                </select>
            </div>
            <div class="form-group full">
                <label asp-for="ImageUrl">Image URL</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="/img/vehicle-1.jpg" />
            </div>
            <div class="form-group full">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Short description..."></textarea>
            </div>
            <div class="form-group full">
                <label class="form-check">
                    <input asp-for="IsAvailable" type="checkbox" /> Available for rent
                </label>
            </div>
        </div>

        <button type="submit" class="btn btn-neon" style="margin-top:20px;">
            <i class="fas fa-floppy-disk"></i> Save Car
        </button>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
}
