@model List<CentalMvc.Models.Car>
@{
    ViewData["Title"] = "Cars";
    ViewData["Active"] = "cars";
    Layout = "_AdminLayout";
}

<div class="panel">
    <div class="panel-head">
        <h5><i class="fas fa-car me-2"></i>Manage Cars (@Model.Count)</h5>
        <a asp-controller="Cars" asp-action="Create" class="btn btn-neon btn-sm"><i class="fas fa-plus"></i> Add Car</a>
    </div>

    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No cars yet. Add your first car.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th><th>Brand</th><th>Type</th><th>Year</th>
                    <th>Price/Day</th><th>Available</th><th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="car-name">@c.Name</td>
                        <td>@c.Brand</td>
                        <td>@c.CarType</td>
                        <td>@c.ModelYear</td>
                        <td>$@c.PricePerDay</td>
                        <td>
                            @if (c.IsAvailable)
                            {
                                <span class="badge-pill badge-yes">Yes</span>
                            }
                            else
                            {
                                <span class="badge-pill badge-no">No</span>
                            }
                        </td>
                        <td style="text-align:right;white-space:nowrap;">
                            <a asp-controller="Cars" asp-action="Edit" asp-route-id="@c.Id" class="btn btn-ghost btn-sm"><i class="fas fa-pen"></i></a>
                            <form asp-controller="Cars" asp-action="Delete" asp-route-id="@c.Id" method="post" style="display:inline;"
                                  onsubmit="return confirm('Delete this car?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
