@model List<CentalMvc.Models.BlogPost>
@{
    ViewData["Title"] = "Blog & News";
}

<div class="bg-breadcrumb">
    <div class="container text-center py-4">
        <h3 class="text-white mb-2">Blog & News</h3>
        <ol class="breadcrumb justify-content-center mb-0">
            <li class="breadcrumb-item"><a asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active text-white">Blog</li>
        </ol>
    </div>
</div>

<div class="container-fluid blog py-5">
    <div class="container">
        <div class="row g-4">
            @if (Model.Count == 0)
            {
                <p class="text-center">No blog posts yet.</p>
            }
            else
            {
                @foreach (var post in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="blog-item h-100">
                            <div class="blog-img">
                                <img src="@post.ImageUrl" class="img-fluid rounded-top w-100"
                                     style="height:240px;object-fit:cover;" alt="@post.Title"
                                     onerror="this.src='/img/blog-1.jpg'">
                            </div>
                            <div class="blog-content rounded-bottom p-4">
                                <div class="blog-date">@post.PublishedDate.ToString("dd MMM yyyy")</div>
                                <div class="blog-comment my-3">
                                    <div class="small"><span class="fa fa-user text-primary"></span><span class="ms-2">@post.Author</span></div>
                                    <div class="small"><span class="fa fa-comment-alt text-primary"></span><span class="ms-2">@post.CommentsCount Comments</span></div>
                                </div>
                                <a asp-action="BlogDetails" asp-route-id="@post.Id" class="h4 d-block mb-3">@post.Title</a>
                                <p class="mb-3">@post.Summary</p>
                                <a asp-action="BlogDetails" asp-route-id="@post.Id">Read More <i class="fa fa-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
